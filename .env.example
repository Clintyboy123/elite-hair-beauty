# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds real passwords and must never be committed or shared.
# Generate each password/secret with:      openssl rand -base64 32

# --- Application -------------------------------------------------------------
NODE_ENV=production
APP_NAME="Elite Hair & Beauty"

# Unique per website. Names this site's containers, network and database volume.
# Lowercase letters, numbers, dashes and underscores only, e.g. the domain without dots.
COMPOSE_PROJECT_NAME=elitehair

# --- Ports -------------------------------------------------------------------
# The port the VPS-level Nginx forwards this domain to. Must be unique per website on the VPS.
FRONTEND_PORT=8105

# Internal only (never public). If you change it, change it in frontend/nginx/default.conf too.
BACKEND_PORT=3000

# How many proxies sit in front of the API: 2 on the VPS (VPS Nginx + frontend Nginx).
TRUST_PROXY=2

# --- Database ----------------------------------------------------------------
MYSQL_DATABASE=elitehair
MYSQL_USER=elitehair
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# The database's Docker service name and port. Leave as they are.
DB_HOST=database
DB_PORT=3306

# --- Project-specific -----------------------------------------------------------
# Form emails. Every contact message, wedding enquiry and newsletter sign-up is saved in the database. If SMTP is
# set, messages and wedding enquiries are also emailed to MAIL_TO (and brides get an acknowledgement).
# Leave SMTP_HOST empty to only save them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Elite Hair & Beauty <no-reply@elitehair.co.za>"
MAIL_TO=info@elitehair.co.za

# The salon's WooCommerce shop (products, basket, checkout, payment, delivery). If WordPress moves to its own
# address when this site takes over the domain (e.g. https://shop.elitehair.co.za), change it here.
SHOP_URL=https://www.elitehair.co.za
SHOP_CACHE_MINUTES=10

# --- Deployment (set on the VPS by deploy/deploy.sh; leave unset on your computer) ---
# The exact images to run, e.g. ghcr.io/<owner>/<repo>-frontend:sha-<commit>. Unset = build locally.
# FRONTEND_IMAGE=
# BACKEND_IMAGE=
